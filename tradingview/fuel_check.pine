// This Pine Script® code is subject to the terms of the Mozilla Public License 2.0 at https://mozilla.org/MPL/2.0/
// VIX Collapse – Fuel Check. Research behind it: check_vanna.py (V3), pre-registered 2026-11-15.
//@version=6
indicator("VIX Collapse – Fuel Check", shorttitle = "Fuel Check", overlay = true, max_labels_count = 500)

// ───────────────────────────── inputs (defaults = the tested rule)
vixSym    = input.symbol("CBOE:VIX", "Implied-vol index")
refSym    = input.symbol("AMEX:SPY", "Index for realized vol and returns")
dropPct   = input.float(20.0, "VIX drop that counts as a collapse (%)", minval = 1.0)
lookback  = input.int(3, "...over this many sessions", minval = 1)
rvLen     = input.int(21, "Realized-vol window (sessions)", minval = 5)
gapLen    = input.int(10, "Minimum sessions between episodes", minval = 1)
fwdLen    = input.int(5, "Forward window for the stats (sessions)", minval = 1)
statsFrom = input.time(timestamp("2007-01-01T00:00:00"), "Count episodes from")
showTable = input.bool(true, "Show table")
showBg    = input.bool(true, "Shade the forward window")

if not timeframe.isdaily
    runtime.error("Fuel Check is defined on daily closes: switch the chart to 1D.")

// ───────────────────────────── daily data (closed bars only, so nothing repaints)
vix = request.security(vixSym, "D", close, lookahead = barmerge.lookahead_off)
ref = request.security(refSym, "D", close, lookahead = barmerge.lookahead_off)

rv  = ta.stdev(math.log(ref / ref[1]), rvLen, biased = false) * math.sqrt(252) * 100.0   // annualised %, sample st. dev.
chg = vix / vix[lookback] - 1.0

// ───────────────────────────── episodes
var int lastEv = na
isEvent = barstate.isconfirmed and not na(rv) and not na(chg) and chg <= -dropPct / 100.0 and (na(lastEv) or bar_index - lastEv >= gapLen)
spent   = vix < rv

var int   evBar   = na
var bool  evSpent = na
var float evClose = na
var int   evTime  = na

// pending episodes waiting for their forward return
var array<int>   pBar   = array.new<int>()
var array<float> pClose = array.new<float>()
var array<bool>  pSpent = array.new<bool>()
var array<int>   pTime  = array.new<int>()
// completed forward returns (bp)
var array<float> rSpent = array.new<float>()
var array<float> rLeft  = array.new<float>()

if isEvent
    lastEv  := bar_index
    evBar   := bar_index
    evSpent := spent
    evClose := ref
    evTime  := time
    array.push(pBar, bar_index)
    array.push(pClose, ref)
    array.push(pSpent, spent)
    array.push(pTime, time)
    label.new(bar_index, high, (spent ? "FUEL SPENT" : "FUEL LEFT") + "\nVIX " + str.tostring(chg * 100, "#") + "% in " + str.tostring(lookback) + "d\nVIX " + str.tostring(vix, "#.0") + " vs RV " + str.tostring(rv, "#.0"),
              style = label.style_label_down, color = spent ? color.new(color.orange, 10) : color.new(color.teal, 10), textcolor = color.white, size = size.small)

if barstate.isconfirmed and array.size(pBar) > 0
    for i = array.size(pBar) - 1 to 0
        if bar_index - array.get(pBar, i) == fwdLen
            r = math.log(ref / array.get(pClose, i)) * 10000.0
            if array.get(pTime, i) >= statsFrom
                if array.get(pSpent, i)
                    array.push(rSpent, r)
                else
                    array.push(rLeft, r)
            array.remove(pBar, i)
            array.remove(pClose, i)
            array.remove(pSpent, i)
            array.remove(pTime, i)

inWindow = not na(evBar) and bar_index > evBar and bar_index <= evBar + fwdLen
bgcolor(showBg and inWindow ? (evSpent ? color.new(color.orange, 88) : color.new(color.teal, 88)) : na)

// ───────────────────────────── table
upShare(a) =>
    n = 0
    for v in a
        if v > 0
            n += 1
    array.size(a) > 0 ? n * 100.0 / array.size(a) : na

fmtStats(a) =>
    array.size(a) == 0 ? "—" : "n " + str.tostring(array.size(a)) + " · mean " + str.tostring(array.avg(a), "+#;-#") + " bp · median " + str.tostring(array.median(a), "+#;-#") + " bp · up " + str.tostring(upShare(a), "#") + "%"

if showTable and barstate.islast
    var table t = table.new(position.top_right, 2, 9, bgcolor = color.new(color.black, 15), border_width = 1, border_color = color.new(color.gray, 60))
    dim = color.new(color.gray, 0)
    table.cell(t, 0, 0, "VIX Collapse – Fuel Check", text_color = color.white, text_size = size.small)
    table.cell(t, 1, 0, "context, not a signal", text_color = dim, text_size = size.small)
    table.cell(t, 0, 1, "Now", text_color = dim, text_size = size.small)
    table.cell(t, 1, 1, "VIX " + str.tostring(vix, "#.0") + " · " + str.tostring(rvLen) + "d realized " + str.tostring(rv, "#.0") + " · VIX " + str.tostring(chg * 100, "+#;-#") + "% in " + str.tostring(lookback) + "d", text_color = color.white, text_size = size.small)
    table.cell(t, 0, 2, "Latest episode", text_color = dim, text_size = size.small)
    table.cell(t, 1, 2, na(evTime) ? "—" : str.format_time(evTime, "yyyy-MM-dd", "America/New_York") + (evSpent ? " · FUEL SPENT (VIX < realized)" : " · FUEL LEFT (VIX ≥ realized)") + " · " + str.tostring(bar_index - evBar) + " sessions ago", text_color = na(evSpent) ? dim : evSpent ? color.orange : color.teal, text_size = size.small)
    table.cell(t, 0, 3, "This chart: spent", text_color = dim, text_size = size.small)
    table.cell(t, 1, 3, "next " + str.tostring(fwdLen) + " sessions: " + fmtStats(rSpent), text_color = color.orange, text_size = size.small)
    table.cell(t, 0, 4, "This chart: left", text_color = dim, text_size = size.small)
    table.cell(t, 1, 4, "next " + str.tostring(fwdLen) + " sessions: " + fmtStats(rLeft), text_color = color.teal, text_size = size.small)
    table.cell(t, 0, 5, "Published test", text_color = dim, text_size = size.small)
    table.cell(t, 1, 5, "SPY 2007-08..2026-08, 72 episodes: spent n 27, next 5 sessions −161 bp (median −8, up 44%); left n 45, +63 bp (median +87, up 69%)", text_color = color.white, text_size = size.small)
    table.cell(t, 0, 6, "Gap", text_color = dim, text_size = size.small)
    table.cell(t, 1, 6, "spent − left −224 bp, 95% CI [−431, −29], same sign 2007-16 and 2017-26 · all days +17 bp", text_color = color.white, text_size = size.small)
    table.cell(t, 0, 7, "Caveat", text_color = dim, text_size = size.small)
    table.cell(t, 1, 7, "fragile: Oct 2008 alone is −1,630 bp; without the worst three crash episodes the gap is −85 bp. Medians differ less than means.", text_color = color.yellow, text_size = size.small)
    table.cell(t, 0, 8, "Reading", text_color = dim, text_size = size.small)
    table.cell(t, 1, 8, "'Spent' = VIX fell while realized vol is still bigger: the calm in options came before the calm in price.", text_color = dim, text_size = size.small)
